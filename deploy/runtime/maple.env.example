# Example only. Production values live on the mini PC:
# D:\server-data\maple\runtime\.env

MAPLE_LOCAL_PORT=9040
ADMIN_TOKEN=replace-with-long-random-value
CORS_ORIGINS=

# Auction fees, guild shop discount, PC-room rule ceilings and fixed shop
# prices are game rules owned by the Maple repository, not runtime env values.

DB_NAME=maple_craft
DB_USER=maple_app
DB_PASSWORD=replace-with-long-random-value
DB_ROOT_PASSWORD=replace-with-long-random-value
