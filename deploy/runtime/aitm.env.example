# Server-local Aitm runtime values. Keep secrets out of Git.
AITM_LOCAL_PORT=9060
DB_NAME=aitm_db
DB_USER=aitm
AITM_DB_PASSWORD=change-me
AITM_DB_ROOT_PASSWORD=change-me
AITM_AI_SECURE_TOKEN=change-me
OPENAI_API_KEY=
AITM_ALLOWED_VIDEO_HOSTS=storage.googleapis.com
# Charset conversion is maintenance-only and disabled during normal app startup.
DB_CHARSET_MIGRATION_ENABLED=false
DB_CHARSET_MIGRATION_LOCK_WAIT_SECONDS=10
