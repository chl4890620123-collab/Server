# Example only. Production values live on the mini PC:
# D:\server-data\hub\runtime\.env
# deploy-hub.ps1 creates that file automatically on first deploy with random secrets already filled
# in - you only need to add GEMINI_API_KEY (and any connector tokens you want to enable) afterward.

HUB_HOST_PORT=9070
DB_NAME=hub
DB_USER=hub
DB_PASSWORD=replace-with-long-random-value

HUB_JWT_SECRET=replace-with-long-random-value
HUB_ADMIN_SETUP_KEY=replace-with-long-random-value
HUB_STT_PII_HASH_KEY=replace-with-long-random-value
HUB_COOKIE_SECURE=false
HUB_ENFORCE_SECURE_CONFIG=false

# Real domain this app answers on through the existing shared MOVEAI Caddy (host 80/443).
# yellow.it.kr (apex) was reassigned from Dahum to Hub - see HUB_ALLOW_DOMAIN_TAKEOVER below.
HUB_PUBLIC_DOMAIN=yellow.it.kr
HUB_PUBLIC_BASE_URL=https://yellow.it.kr
# true registers/updates the HUB_PUBLIC_DOMAIN site block on the shared MOVEAI Caddy on every
# deploy. Requires DNS for HUB_PUBLIC_DOMAIN to already point at this server. Set false to leave
# the shared Caddyfile untouched and only run Hub on its local HUB_HOST_PORT.
HUB_OUTER_CADDY_AUTO_CONFIGURE=true
# true lets ensure-public-route.ps1 remove another app's existing managed route block for
# HUB_PUBLIC_DOMAIN before adding Hub's own (needed once, to take yellow.it.kr away from Dahum;
# harmless afterward since the domain is then already Hub's). Set false to fail loudly instead if
# HUB_PUBLIC_DOMAIN ever collides with another app's route again.
HUB_ALLOW_DOMAIN_TAKEOVER=true
# Only needed if the shared MOVEAI Caddy stack does not live at the default C:\saver.
MOVEAI_ROOT=C:/saver

HUB_AI_MODE=gemini
GEMINI_API_KEY=
HUB_EMBED_MODE=e5

# Read-only external connectors - fill only the services you enable. See the Hub repo's own
# .env.example for what each one does.
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=
SLACK_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=
NOTION_TOKEN=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
HUB_ALLOW_SHARED_CONNECTOR_FALLBACK=false
