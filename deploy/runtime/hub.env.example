# Example only. Production values live on the mini PC:
# D:\server-data\hub\runtime\.env
# deploy-hub.ps1 creates that file automatically on first deploy with random secrets already filled
# in - you only need to add GEMINI_API_KEY (and any connector tokens you want to enable) afterward.

HUB_HOST_PORT=9070
HUB_HTTPS_HOST_PORT=9443
DB_NAME=hub
DB_USER=hub
DB_PASSWORD=replace-with-long-random-value

HUB_JWT_SECRET=replace-with-long-random-value
HUB_ADMIN_SETUP_KEY=replace-with-long-random-value
HUB_STT_PII_HASH_KEY=replace-with-long-random-value
HUB_COOKIE_SECURE=true
HUB_ENFORCE_SECURE_CONFIG=true

# Hub uses its own Caddy for automatic HTTPS. Forward public TCP 443 to this host's
# HUB_HTTPS_HOST_PORT (9443 by default). HUB_HOST_PORT (9070) is the HTTP redirect listener.
# Confirm that the router/NAT and any existing shared reverse proxy do not already own this
# domain's public TCP 443 route before deploying.
HUB_PUBLIC_DOMAIN=yellow.it.kr
HUB_PUBLIC_BASE_URL=https://yellow.it.kr

HUB_AI_MODE=gemini
GEMINI_API_KEY=
HUB_EMBED_MODE=e5

# Read-only external connectors - fill only the services you enable. See the Hub repo's own
# .env.example for what each one does.
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=
SLACK_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=
NOTION_TOKEN=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
HUB_ALLOW_SHARED_CONNECTOR_FALLBACK=false
