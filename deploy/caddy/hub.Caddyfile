# Hub's own gateway - hub's direct public entry point (does not route through the shared MOVEAI
# Caddy; see deploy/compose/hub.yml).
# Host :HUB_HOST_PORT -> Hub Caddy :80 -> Spring Boot :8080.
# Static frontend is served by Spring Boot itself, so there is no separate frontend host port.
# Plain HTTP: nothing else terminates TLS in front of this, so HUB_COOKIE_SECURE/
# HUB_ENFORCE_SECURE_CONFIG stay false until this gets its own certificate.
:80 {
    encode zstd gzip

    reverse_proxy backend:8080 {
        header_up Host {http.request.host}
        header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
        header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
        header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
    }
}
