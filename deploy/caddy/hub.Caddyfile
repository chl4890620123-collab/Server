# Hub's dedicated public gateway. Caddy obtains and renews the certificate for
# HUB_PUBLIC_DOMAIN automatically. Forward public TCP 443 to HUB_HTTPS_HOST_PORT
# (default 9443) on this host; HUB_HOST_PORT remains the HTTP redirect entry point.
{$HUB_PUBLIC_DOMAIN} {
    encode zstd gzip

    reverse_proxy backend:8080 {
        header_up Host {http.request.host}
        header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
        header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
        header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
    }
}
